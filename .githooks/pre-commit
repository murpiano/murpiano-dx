#!/usr/bin/env bash
# Rejects commits whose author or committer is not the repository owner.
set -euo pipefail

expected='murpiano <159007823+murpiano@users.noreply.github.com>'

for role in AUTHOR COMMITTER; do
  ident=$(git var "GIT_${role}_IDENT" | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')
  if [ "$ident" != "$expected" ]; then
    echo "pre-commit: ${role,,} is \"$ident\", expected \"$expected\"." >&2
    echo "Run: git config user.name murpiano && git config user.email 159007823+murpiano@users.noreply.github.com" >&2
    exit 1
  fi
done
