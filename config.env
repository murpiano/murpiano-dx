# Public template. Personal values are created in ~/.config/murpiano-dx/config.env
# by install.sh and are never committed to this repository.

# Fallback author for a new repository when Git has no configured identity.
# The name matches the GitHub profile name, the email is the account's noreply address:
# commits made on github.com (merge button) are signed the same way when the account keeps
# its email private (Settings -> Emails).
GIT_NAME=""
GIT_EMAIL=""

# GitHub account that owns the repositories.
GITHUB_OWNER=""
